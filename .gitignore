# =========================================================
# Projeto Sentinel - Root .gitignore Consolidado
# Escopo: consolidacao de ".gitignore" e " (2).gitignore"
# Observacao: nao inclui o .gitignore especifico do PBIP
# =========================================================

# ---------------------------------------------------------
# Dados operacionais e saidas do pipeline
# ---------------------------------------------------------
/01_raw/
/02_silver/
/03_database/
/04_database/
/outputs/
/backup_relatorios_anteriores/
/backup_database/
/backup_db/
/backups/

# Arquivos com dados sensiveis ou bases operacionais.
*.db
*.sqlite
*.sqlite3
*.xlsx
*.xlsm
*.xls
*.csv
*.parquet
*.feather
*.pkl
*.pickle

# ---------------------------------------------------------
# Python
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-mcp/
.python_packages/
venv/
env/
/tools/mcp/

# ---------------------------------------------------------
# SQLite / arquivos transientes de banco
# ---------------------------------------------------------
*.db-shm
*.db-wal
*.db-journal
*.sqlite-journal

# ---------------------------------------------------------
# Excel / arquivos temporarios do Office
# ---------------------------------------------------------
~$*.xlsx
~$*.xlsm
~$*.xls
*.tmp

# ---------------------------------------------------------
# Variaveis de ambiente
# ---------------------------------------------------------
.env
.env.local
.env.production
.env.test
*.local
mcp.local.json
mcp_client.local.json
mcp_servers.local.json
.mcp.local.json
.mcp*.local.json
.vscode/mcp.local.json
.vscode/mcp.*.local.json

# ---------------------------------------------------------
# Logs
# ---------------------------------------------------------
/logs/
*.log
mcp_server/logs/*.jsonl
!mcp_server/logs/.gitkeep

# ---------------------------------------------------------
# Tooling auxiliar ja presente no repositorio
# Mantido para nao perder regras existentes
# ---------------------------------------------------------
/node_modules/
/dist/
/dist-ssr/
*.tsbuildinfo
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ---------------------------------------------------------
# IDEs / sistema operacional
# ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
